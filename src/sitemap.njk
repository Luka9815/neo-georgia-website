---
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">{% for view in views %}{% if view.kind != '404' and view.kind != 'redirect' and view.kind != 'legacyRedirect' and not view.noindex %}<url><loc>{{ view.path | absoluteUrl(site.url) }}</loc><xhtml:link rel="alternate" hreflang="{{ view.lang }}" href="{{ view.path | absoluteUrl(site.url) }}"/>{% if view.translated != false %}<xhtml:link rel="alternate" hreflang="{{ 'en' if view.lang == 'ka' else 'ka' }}" href="{{ view.alternate | absoluteUrl(site.url) }}"/>{% endif %}</url>{% endif %}{% endfor %}</urlset>
