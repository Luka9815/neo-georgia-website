---
pagination:
  data: pageTypes.story
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}

{% block pageContent %}
{% set item = catalog[view.kind] | localise(view.lang) | findSlug(view.slug) %}
{{ item.body | markdown | safe }}
{% endblock %}
