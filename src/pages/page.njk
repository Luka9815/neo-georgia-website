---
pagination:
  data: pageTypes.page
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}

{% block pageContent %}
{% set item = catalog[view.kind] | localise(view.lang) | findSlug(view.slug) %}
{% if view.slug == 'about' %}
{% from 'portal-photo.njk' import portalPhoto %}
{{ portalPhoto(portalPhotos[photoPlacements.about],view.lang) }}
{% endif %}
{{ item.body | markdown | safe }}
{% if view.slug == 'about' %}
<ul>
  <li><a href="/{{ view.lang }}/about/team/">{{ t.team }}</a></li>
  <li><a href="/{{ view.lang }}/here/">{{ t.here }}</a></li>
  <li><a href="/{{ view.lang }}/about/contact/">{{ t.contact }}</a></li>
</ul>
{% endif %}
{% if item.policyKey %}<p>{{ t[item.policyKey] }}</p>{% endif %}
{% endblock %}
