---
pagination:
  data: pageTypes.contact
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}
{% block pageContent %}
<dl>
  <dt>{{ t.address }}</dt><dd>{{ t.contactAddress }}</dd>
  <dt>{{ t.officeHours }}</dt><dd>{{ t.contactHours }}</dd>
  <dt>{{ t.email }}</dt><dd>{{ t.contactEmail }}</dd>
</dl>
{% endblock %}
