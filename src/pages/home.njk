---
pagination:
  data: pageTypes.home
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}
{% from 'portal-photo.njk' import portalPhoto %}
{% from 'home-band.njk' import homeHeading, compactUpdate %}
{% from 'sector.njk' import sectorHeading %}
{% block pageContent %}
<section class="home-hero" aria-labelledby="home-title">
 <div class="wrapper hero-grid">
  <div class="hero-main"><p class="eyebrow">{{ t.homeEyebrow }}</p><h1 id="home-title">{{ t.homeHeadline }}</h1><p class="hero-intro">{{ t.purpose }}</p>
   <div class="entry"><a class="button button-on-dark" href="/{{ view.lang }}/find/student/">{{ t.individuals }}</a><a class="button button-on-dark button-secondary" href="/{{ view.lang }}/find/university/">{{ t.organisations }}</a></div>
  </div>
  {{ portalPhoto(portalPhotos[photoPlacements.home],view.lang,'hero',t) }}
 </div>
</section>
<section class="home-band home-audiences" aria-labelledby="audiences-title"><span class="band-decoration" aria-hidden="true"></span><div class="wrapper">
 {{ homeHeading('audiences-title', t.find, t.homeSectionEyebrows.audiences, '/' ~ view.lang ~ '/find/', t.homeGuideLink) }}
 {% set audienceHeading = 'h3' %}{% include 'audience-tiles.njk' %}
</div></section>
<section class="home-band band-soft" aria-labelledby="actions-title"><div class="wrapper">
 {{ homeHeading('actions-title', t.opportunities, t.homeSectionEyebrows.actions, '/' ~ view.lang ~ '/opportunities/', t.allOpportunities) }}
 {% for sector in ['higher-education','vet','youth','sport'] %}
 <section class="home-action-sector" data-sector="{{ sector }}" aria-labelledby="home-{{ sector }}">{{ sectorHeading(sector, t, 'home-' ~ sector) }}{{ cards(actions | primarySector(sector),'action',t,view.lang,'h4',compact=true,sector=sector) }}</section>
 {% endfor %}
</div></section>
<section class="home-band home-figures" aria-labelledby="figures-title">
 {{ portalPhoto(portalPhotos[photoPlacements.figures],view.lang,'figures',t) }}
 <div class="wrapper">
 {{ homeHeading('figures-title', t.figures, t.homeSectionEyebrows.figures) }}
 <dl class="figures">{% for key,label,figureIcon in [['total','projectCount','network'],['organisations','projectNamedOrganisations','building'],['coordinated','projectCoordinated','globe']] %}<div><dt>{{ figureIcon | icon | safe }}{{ t[label] }}</dt><dd><a href="/{{ view.lang }}/resources/statistics/">{{ projectData.stats[key] }}</a></dd></div>{% endfor %}</dl>
 <p class="figures-note">{{ t.projectSnapshot }}: <time datetime="{{ projectData.snapshotDate }}">{{ projectData.snapshotDate | dateLabel(t,'UTC',false) }}</time>.</p>
 <h3>{{ t.projectYears }}</h3>
 <div class="chart-scroll" tabindex="0" role="group" aria-label="{{ t.projectYears }}">{{ projectData.stats.years | miniChart(t.projectYears,t.homeChartDescription,view.lang ~ '-home-years') | safe }}</div>
 <details class="chart-table figures-data"><summary>{{ t.figuresDataAbout }}</summary>
  {% include 'project-mobility-coverage.njk' %}
 </details>
 <details class="chart-table"><summary>{{ t.chartTable }}</summary><div class="project-statistics-scroll" tabindex="0" role="group" aria-label="{{ t.projectYears }}"><table class="project-statistics"><caption>{{ t.projectYears }}</caption><thead><tr><th scope="col">{{ t.projectCallYear }}</th><th scope="col">{{ t.projectCount }}</th></tr></thead><tbody>{% for row in projectData.stats.years %}<tr><th scope="row">{{ row.key }}</th><td>{{ row.count }}</td></tr>{% endfor %}</tbody></table></div></details>
 <p><a href="/{{ view.lang }}/resources/statistics/">{{ t.projectStatistics }}</a></p>
</div></section>
{% set nextCalls = calls | withoutStatus('closed') | take(3) %}
{% set nextEvents = events | status('upcoming') | take(3) %}
<div class="home-band home-updates"><div class="wrapper">
{% if nextCalls.length %}
<section aria-labelledby="deadlines-title">
 {{ homeHeading('deadlines-title', t.deadlines, t.homeSectionEyebrows.calls, '/' ~ view.lang ~ '/calls/', t.allCalls) }}
 {{ cards(nextCalls,'call',t,view.lang,showSectionLabel=true) }}
</section>
{% else %}
 {{ compactUpdate('/' ~ view.lang ~ '/calls/', t.callsCompact, 'book-open') }}
{% endif %}
{% if nextEvents.length %}
<section aria-labelledby="events-title">
 {{ homeHeading('events-title', t.upcomingEvents, t.homeSectionEyebrows.events, '/' ~ view.lang ~ '/events/', t.allEvents) }}
 {{ cards(nextEvents,'event',t,view.lang,showSectionLabel=true) }}
</section>
{% else %}
 {{ compactUpdate('/' ~ view.lang ~ '/events/', t.eventsCompact, 'calendar') }}
{% endif %}
</div></div>
<section class="home-band home-news" aria-labelledby="news-title"><span class="band-decoration" aria-hidden="true"></span><div class="wrapper">
 {{ homeHeading('news-title', t.latestNews, t.homeSectionEyebrows.news, '/' ~ view.lang ~ '/news/', t.allNews) }}
 {{ cards(news | take(3),'news',t,view.lang,photoCredits=portalPhotos) }}
</div></section>
{% if stories.length %}<section class="home-band home-story" aria-labelledby="story-title"><div class="wrapper">
 {{ homeHeading('story-title', t.story, t.homeSectionEyebrows.stories, '/' ~ view.lang ~ '/stories/', t.allStories) }}
 {{ cards(stories | take(1),'story',t,view.lang,showSectionLabel=true) }}
</div></section>{% endif %}
{% endblock %}
