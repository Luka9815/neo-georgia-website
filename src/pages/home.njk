---
pagination:
  data: pageTypes.home
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}

{% block pageContent %}
<section class="home-hero" aria-labelledby="home-title">
  <div class="hero-main">
    <p class="eyebrow">{{ t.homeEyebrow }}</p>
    <h1 id="home-title">{{ t.homeHeadline }}</h1>
    <p class="hero-intro">{{ t.purpose }}</p>
    <div class="entry">
      <a class="button" href="/{{ view.lang }}/opportunities/#individuals">{{ t.individuals }}</a>
      <a class="button button-secondary" href="/{{ view.lang }}/opportunities/#organisations">{{ t.organisations }}</a>
    </div>
  </div>
  <aside class="hero-guide" aria-labelledby="guide-title">
    <h2 id="guide-title">{{ t.homeGuideTitle }}</h2>
    <p>{{ t.homeGuideBody }}</p>
    <a href="/{{ view.lang }}/opportunities/">{{ t.homeGuideLink }}</a>
  </aside>
</section>
<section class="home-section" aria-labelledby="deadlines-title">
  <div class="section-heading">
    <h2 id="deadlines-title">{{ t.deadlines }}</h2>
    <a href="/{{ view.lang }}/calls/">{{ t.allCalls }}</a>
  </div>
  {{ cards(calls | withoutStatus('closed') | take(3), 'call', t, view.lang, showSectionLabel=true) }}
</section>
<section class="home-section" aria-labelledby="events-title">
  <div class="section-heading">
    <h2 id="events-title">{{ t.upcomingEvents }}</h2>
    <a href="/{{ view.lang }}/events/">{{ t.allEvents }}</a>
  </div>
  {{ cards(events | status('upcoming') | take(3), 'event', t, view.lang, showSectionLabel=true) }}
</section>
<section class="home-section" aria-labelledby="news-title">
  <div class="section-heading">
    <h2 id="news-title">{{ t.latestNews }}</h2>
    <a href="/{{ view.lang }}/news/">{{ t.allNews }}</a>
  </div>
  {{ cards(news | take(3), 'news', t, view.lang, showSectionLabel=true) }}
</section>
<section class="home-story" aria-labelledby="story-title">
  <div class="section-heading">
    <h2 id="story-title">{{ t.story }}</h2>
    <a href="/{{ view.lang }}/stories/">{{ t.allStories }}</a>
  </div>
  {{ cards(stories | take(1), 'story', t, view.lang, showSectionLabel=true) }}
</section>
<section class="home-figures" aria-labelledby="figures-title">
  <h2 id="figures-title">{{ t.figures }}</h2>
  <dl class="figures">
    {% for key, label in [['total','projectCount'], ['organisations','projectNamedOrganisations'], ['coordinated','projectCoordinated']] %}
      <div><dt>{{ t[label] }}</dt><dd><a href="/{{ view.lang }}/resources/statistics/">{{ projectData.stats[key] }}</a></dd></div>
    {% endfor %}
  </dl>
  <p class="figures-note">{{ t.projectSnapshot }}: <time datetime="{{ projectData.snapshotDate }}">{{ projectData.snapshotDate | dateLabel(t, 'UTC', false) }}</time>.</p>
</section>
{% endblock %}
