---
pagination:
  data: pageTypes.home
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}
{% from 'portal-photo.njk' import portalPhoto %}
{% block pageContent %}
<section class="home-hero" aria-labelledby="home-title">
 <div class="wrapper hero-grid">
  <div class="hero-main"><p class="eyebrow">{{ t.homeEyebrow }}</p><h1 id="home-title">{{ t.homeHeadline }}</h1><p class="hero-intro">{{ t.purpose }}</p>
   <div class="entry"><a class="button" href="/{{ view.lang }}/find/student/">{{ t.individuals }}</a><a class="button button-secondary" href="/{{ view.lang }}/find/university/">{{ t.organisations }}</a></div>
  </div>
  {{ portalPhoto(portalPhotos[photoPlacements.home],view.lang,'hero') }}
 </div>
</section>
<section class="home-band band-soft" aria-labelledby="audiences-title"><div class="wrapper">
 <div class="section-heading"><h2 id="audiences-title">{{ t.find }}</h2><a href="/{{ view.lang }}/find/">{{ t.homeGuideLink }}</a></div>
 {% set audienceHeading = 'h3' %}{% include 'audience-tiles.njk' %}
</div></section>
<section class="home-band" aria-labelledby="actions-title"><div class="wrapper">
 <div class="section-heading"><h2 id="actions-title">{{ t.opportunities }}</h2><a href="/{{ view.lang }}/opportunities/">{{ t.allOpportunities }}</a></div>
 {% for sector in ['higher-education','vet','youth','sport'] %}
 <section class="home-action-sector" aria-labelledby="home-{{ sector }}"><h3 id="home-{{ sector }}">{{ t.sectorLabels[sector] }}</h3>{{ cards(actions | primarySector(sector),'action',t,view.lang,'h4',compact=true) }}</section>
 {% endfor %}
</div></section>
<section class="home-band home-figures" aria-labelledby="figures-title"><div class="wrapper">
 <h2 id="figures-title">{{ t.figures }}</h2>
 <dl class="figures">{% for key,label in [['total','projectCount'],['organisations','projectNamedOrganisations'],['coordinated','projectCoordinated']] %}<div><dt>{{ t[label] }}</dt><dd><a href="/{{ view.lang }}/resources/statistics/">{{ projectData.stats[key] }}</a></dd></div>{% endfor %}</dl>
 <p class="figures-note">{{ t.projectSnapshot }}: <time datetime="{{ projectData.snapshotDate }}">{{ projectData.snapshotDate | dateLabel(t,'UTC',false) }}</time>.</p>
 <h3>{{ t.projectYears }}</h3>
 <div class="chart-scroll" tabindex="0" role="group" aria-label="{{ t.projectYears }}">{{ projectData.stats.years | miniChart(t.projectYears,t.homeChartDescription,view.lang ~ '-home-years') | safe }}</div>
 {% include 'project-mobility-coverage.njk' %}
 <details class="chart-table"><summary>{{ t.chartTable }}</summary><table class="project-statistics"><caption>{{ t.projectYears }}</caption><thead><tr><th scope="col">{{ t.projectCallYear }}</th><th scope="col">{{ t.projectCount }}</th></tr></thead><tbody>{% for row in projectData.stats.years %}<tr><th scope="row">{{ row.key }}</th><td>{{ row.count }}</td></tr>{% endfor %}</tbody></table></details>
 <p><a href="/{{ view.lang }}/resources/statistics/">{{ t.projectStatistics }}</a></p>
</div></section>
{% set nextCalls = calls | withoutStatus('closed') | take(3) %}
{% if nextCalls.length %}
<section class="home-band" aria-labelledby="deadlines-title"><div class="wrapper"><div class="section-heading"><h2 id="deadlines-title">{{ t.deadlines }}</h2><a href="/{{ view.lang }}/calls/">{{ t.allCalls }}</a></div>{{ cards(nextCalls,'call',t,view.lang,showSectionLabel=true) }}</div></section>
{% else %}<div class="wrapper"><p class="compact-update"><a href="/{{ view.lang }}/calls/">{{ t.callsCompact }}</a></p></div>{% endif %}
{% set nextEvents = events | status('upcoming') | take(3) %}
{% if nextEvents.length %}
<section class="home-band" aria-labelledby="events-title"><div class="wrapper"><div class="section-heading"><h2 id="events-title">{{ t.upcomingEvents }}</h2><a href="/{{ view.lang }}/events/">{{ t.allEvents }}</a></div>{{ cards(nextEvents,'event',t,view.lang,showSectionLabel=true) }}</div></section>
{% else %}<div class="wrapper"><p class="compact-update"><a href="/{{ view.lang }}/events/">{{ t.eventsCompact }}</a></p></div>{% endif %}
<section class="home-band band-soft" aria-labelledby="news-title"><div class="wrapper"><div class="section-heading"><h2 id="news-title">{{ t.latestNews }}</h2><a href="/{{ view.lang }}/news/">{{ t.allNews }}</a></div>{{ cards(news | take(3),'news',t,view.lang,showSectionLabel=true) }}</div></section>
{% if stories.length %}<section class="home-band home-story" aria-labelledby="story-title"><div class="wrapper"><div class="section-heading"><h2 id="story-title">{{ t.story }}</h2><a href="/{{ view.lang }}/stories/">{{ t.allStories }}</a></div>{{ cards(stories | take(1),'story',t,view.lang,showSectionLabel=true) }}</div></section>{% endif %}
{% endblock %}
