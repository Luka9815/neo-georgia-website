---
pagination:
  data: pageTypes.event
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}

{% block pageContent %}
{% set item = events | findSlug(view.slug) %}
<p><a href="/{{ view.lang }}/events/{{ item.slug }}/event.ics" download>{{ t.downloadEvent }}</a></p>
<p>
  <time datetime="{{ item.date }}">{{ item.date | dateLabel(t, item.timeZone) }}</time> ({{ item.timeZone }}), {{ t[item.status] }}</p>
  {{ item.body | markdown | safe }}
  <dl>
    <dt>{{ t.venue }}</dt>
    <dd>{{ item.venue }}</dd>
    {% if item.agenda and item.agenda | trim %}
      <dt>{{ t.agenda }}</dt>
      <dd>{{ item.agenda }}</dd>
    {% endif %}
  </dl>
  {% if item.registration and item.registration | trim %}
    <p><a href="{{ item.registration }}">{{ t.registration }}</a></p>
  {% endif %}
  {% for source in ['official','neo','partner'] %}
    <section>
      <h2>{{ t[source] }}</h2>
      {{ cards(resources | forEvent(item.slug) | source(source), 'resource', t, view.lang) }}
    </section>
  {% endfor %}
{% endblock %}
