---
pagination:
  data: pageTypes.faq
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}
{% block pageContent %}
{% for key, label in t.faqTopics %}
  {% set group = faqs | topic(key) %}
  {% if group.length %}
  <section>
    <h2>{{ label }}</h2>
    {{ cards(group, 'faq', t, view.lang) }}
  </section>
  {% endif %}
{% endfor %}
{% endblock %}
