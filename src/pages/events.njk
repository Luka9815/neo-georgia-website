---
pagination:
  data: pageTypes.events
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}

{% block pageContent %}
{% from 'cards.njk' import emptyState %}
{% set calendarUrl = '/' ~ view.lang ~ '/events/calendar/' %}
{% if not events.length %}
{% call emptyState('calendar', calendarUrl, t.eventCalendar) %}<p data-events-empty>{{ t.eventsEmpty }}</p>{% endcall %}
{% else %}
<p><a href="{{ calendarUrl }}">{{ t.eventCalendar }}</a></p>
{% endif %}
<p><a href="/{{ view.lang }}/events/upcoming.ics" download>{{ t.downloadUpcoming }}</a></p>
{% if events.length %}
<section>
  <h2>{{ t.upcomingEvents }}</h2>
  {{ cards(events | status('upcoming'), 'event', t, view.lang) }}
</section>
<section>
  <h2>{{ t.pastEvents }}</h2>
  {{ cards(events | status('past'), 'event', t, view.lang) }}
</section>
{% endif %}
{% endblock %}
