---
pagination:
  data: pageTypes.opportunities
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}

{% block pageContent %}
{% from 'portal-photo.njk' import portalPhoto %}
{{ portalPhoto(portalPhotos[photoPlacements.opportunities],view.lang,'banner',t) }}
<p><a class="button" href="/{{ view.lang }}/find/">{{ t.find }}</a></p>
<p><a href="/{{ view.lang }}/opportunities/find-partners/">{{ t.findPartners }}</a></p>
<section id="individuals">
  <h2>{{ t.individuals }}</h2>
  <p>{{ t.individualsIntro }}</p>
  <ul>
    {% for slug in ['icm', 'erasmus-mundus', 'youth-mobility'] %}<li><a href="/{{ view.lang }}/opportunities/{{ slug }}/">{{ t.projectActionLabels[slug] }}</a></li>{% endfor %}
  </ul>
</section>
<section id="organisations">
  <h2>{{ t.organisations }}</h2>
  {% for sector in ['higher-education', 'vet', 'youth', 'sport'] %}
    <section id="{{ sector }}" class="action-sector">
      <h3>{{ t.sectorLabels[sector] }}</h3>
      {{ cards(actions | sector(sector), 'action', t, view.lang, 'h4') }}
    </section>
  {% endfor %}
</section>
{% endblock %}
