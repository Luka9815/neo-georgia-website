---
pagination:
  data: pageTypes.redirect
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}

{% block pageContent %}
<p>
  <a href="{{ view.target }}">{% if view.path == '/' %}{{ t.returnHome }}{% else %}{{ t.continueToNewPage }}{% endif %}</a>
</p>
{% endblock %}
