---
pagination:
  data: pageTypes.notFound
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}

{% block pageContent %}
<p>
  <a href="/{{ view.lang }}/">{{ t.returnHome }}</a>
</p>
<section id="not-found-en" lang="en">
  <h2>{{ en.notFound }}</h2>
  <p><a href="/en/">{{ en.returnHome }}</a></p>
  <p>{{ en.sample }}</p>
</section>
{% endblock %}
