---
pagination:
  data: pageTypes.publications
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}
{% block pageContent %}
{% set publications = catalog.publication | localise(view.lang) %}
<form class="publication-filters" data-publication-filters hidden aria-label="{{ t.filterPublications }}">
  <label for="publication-year">{{ t.year }}
    <select id="publication-year" name="year"><option value="">{{ t.allYears }}</option>
      {% for year in publications | publicationYears %}<option value="{{ year }}">{{ year }}</option>{% endfor %}
    </select>
  </label>
  <label for="publication-type">{{ t.type }}
    <select id="publication-type" name="type"><option value="">{{ t.allTypes }}</option>
      {% for key, label in t.publicationTypes %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
    </select>
  </label>
  <button type="reset">{{ t.resetFilters }}</button>
  <p role="status" data-publication-count data-label="{{ t.publicationResults }}"></p>
</form>
<ul class="cards" data-publications>
{% for item in publications %}
  <li class="card" data-year="{{ item.year }}" data-type="{{ item.type }}">
    <h2><a href="{{ item.file }}">{{ item.title }}</a></h2>
    <p>{{ t.year }}: {{ item.year }} · {{ t.type }}: {{ t.publicationTypes[item.type] }}</p>
    <p>{{ t.publicationLanguage }}: {{ item.language }}</p>
    {{ item.body | markdown | safe }}
  </li>
{% endfor %}
</ul>
<script type="module" src="/assets/js/publications.js"></script>
{% endblock %}
