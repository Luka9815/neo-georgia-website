---
pagination:
  data: pageTypes.action
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}

{% block pageContent %}
<p><a href="/{{ view.lang }}/opportunities/find-partners/">{{ t.findPartners }}</a></p>
{% set item = actions | findSlug(view.slug) %}
{% if projectData.actionYears[item.slug] %}
<p><a href="/{{ view.lang }}/resources/projects/#action-{{ item.slug }}">{{ t.projectsIndex }}</a></p>
{% endif %}
{{ item.summary | markdown | safe }}
<section>
  <h2>{{ t.who }}</h2>
  <div class="eligibility-note">{{ georgiaEligibility[view.lang] | markdown | safe }}</div>
  {{ item.who | markdown | safe }}
</section>
<section>
  <h2>{{ t.how }}</h2>
  {{ item.how | markdown | safe }}
  <h3>{{ t.officialLinks }}</h3>
  <ul>
    {% for link in item.officialLinks %}
      <li>
        <a href="{{ link.url }}">{{ t[link.labelKey] }}</a>
      </li>
    {% endfor %}
  </ul>
</section>
<section>
  <h2>{{ t.calls }}</h2>
  {{ cards(calls | related(item.slug) | callYear(site.currentCallYear), 'call', t, view.lang) }}
</section>
<section>
  <h2>{{ t.upcomingEvents }}</h2>
  {{ cards(events | related(item.slug) | status('upcoming'), 'event', t, view.lang) }}
</section>
<section>
  <h2>{{ t.pastEvents }}</h2>
  {{ cards(events | related(item.slug) | status('past'), 'event', t, view.lang) }}
</section>
<section>
  <h2>{{ t.resources }}</h2>
  {{ cards(resources | related(item.slug), 'resource', t, view.lang) }}
</section>
{% if (stories | related(item.slug)).length %}
<section>
  <h2>{{ t.story }}</h2>
  {{ cards(stories | related(item.slug), 'story', t, view.lang) }}
</section>
{% endif %}
<section>
  <h2>{{ t.faq }}</h2>
  {{ cards(faqs | related(item.slug), 'faq', t, view.lang) }}
</section>
{% endblock %}
