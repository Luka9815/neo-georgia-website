---
pagination:
  data: pageTypes.projectsIndex
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}
{% block pageContent %}
<dl class="project-summary">
<div><dt>{{ t.projectCount }}</dt><dd>{{ projectData.stats.total }}</dd></div>
<div><dt>{{ t.projectNamedOrganisations }}</dt><dd>{{ projectData.stats.organisations }}</dd></div>
<div><dt>{{ t.projectCoordinated }}</dt><dd>{{ projectData.stats.coordinated }}</dd></div>
</dl>
<p><a href="/{{ view.lang }}/resources/statistics/">{{ t.projectStatistics }}</a></p>
<p>{{ t.projectCoverage }}</p>
<section id="projects-all">
  <h2>{{ t.projectYearIndex }}</h2>
  <ul class="project-year-index">
  {% for year in projectData.yearGroups %}<li><a href="/{{ view.lang }}/resources/projects/{{ year.year }}/">{{ year.year }}</a>: {{ year.count }}</li>{% endfor %}
  </ul>
</section>
<p><a href="#projects-all">{{ t.projectAll }}</a></p>
<div class="project-action-index">
{% for action, years in projectData.actionYears %}
<section id="action-{{ action }}">
  <h2>{{ t.projectActionLabels[action] }}</h2>
  <ul class="project-year-index">
  {% for year in years %}<li><a href="/{{ view.lang }}/resources/projects/{{ year.year }}/#action-{{ action }}">{{ year.year }}</a>: {{ year.count }}</li>{% endfor %}
  </ul>
</section>
{% endfor %}
</div>
{% include 'project-attribution.njk' %}
{% endblock %}
