---
pagination:
  data: pageTypes.credits
  size: 1
  alias: view
permalink: "{{ view.path }}"
eleventyExcludeFromCollections: true
---
{% extends 'page.njk' %}
{% block pageContent %}
{% from 'photo-credit.njk' import photoCredit %}
{% for key,photo in portalPhotos %}
<section data-photo-source="{{ photo.id }}"><h2>{{ photo.alt[view.lang] if photo.author else photo.credit[view.lang] }}</h2>
<p>{{ photoCredit(photo,view.lang,t) }}</p>
</section>
{% endfor %}
{% endblock %}
