{% macro cards(items, type, t, lang, heading='h3') %}
<ul class="cards">
{% for item in items %}
<li>
  {% if type == 'call' %}
  <{{ heading }}><a href="/{{ lang }}/opportunities/{{ item.action }}/">{{ item.title }}</a></{{ heading }}>
  <p><time datetime="{{ item.deadline }}">{{ item.deadline | dateLabel(t) }}</time>, {{ t.brussels }}</p><p>{{ t[item.status] }}</p><a href="{{ item.url }}">{{ t.officialLinks }}</a>
  {% elif type == 'resource' %}
  <{{ heading }}><a href="{{ item.url }}">{{ item.title }}</a></{{ heading }}><p>{{ t.source }}: {{ t[item.source] }}</p>
  {% elif type == 'faq' %}
  <{{ heading }}>{{ item.title }}</{{ heading }}>{{ item.body | markdown | safe }}
  {% else %}
  <{{ heading }}><a href="/{{ lang }}/{% if type == 'action' %}opportunities{% elif type == 'story' %}stories{% else %}{{ type }}{% if type == 'event' %}s{% endif %}{% endif %}/{{ item.slug }}/">{{ item.title }}</a></{{ heading }}>
  {% if item.date %}<p><time datetime="{{ item.date }}">{{ item.date | dateLabel(t, item.timeZone or 'Asia/Tbilisi') }}</time>{% if item.status %}, {{ t[item.status] }}{% endif %}</p>{% endif %}
  {{ item.body | markdown | safe }}
  {% endif %}
</li>
{% else %}<li>{{ t.empty }}</li>{% endfor %}
</ul>
{% endmacro %}
