{% macro cards(items, type, t, lang, heading='h3', showSectionLabel=false) %}
<ul class="cards cards-{{ type }}"{% if type == 'publication' %} data-publications{% endif %}>
  {% for item in items %}
    <li class="card"{% if type == 'publication' %} data-year="{{ item.year }}" data-type="{{ item.type }}"{% endif %}>
      {% if type == 'call' %}
        <div class="card-meta">{% if showSectionLabel %}<span class="card-section-label">{{ t.calls }}</span>{% endif %}<span class="status status-{{ item.status }}">{{ t[item.status] }}</span></div>
        <{{ heading }}><a href="/{{ lang }}/opportunities/{{ item.action }}/">{{ item.title }}</a></{{ heading }}>
        <p class="card-date"><time datetime="{{ item.deadline }}">{{ item.deadline | dateLabel(t) }}</time><br><span class="card-timezone">{{ t.brussels }}</span></p>
        {{ item.body | markdown | safe }}
        <a class="card-link" href="{{ item.url }}">{{ t.officialLinks }}</a>
      {% elif type == 'resource' %}
        <p class="source-label source-{{ item.source }}">{{ t.source }}: {{ t[item.source] }}</p>
        <{{ heading }}><a href="{{ item.url }}">{{ item.title }}</a></{{ heading }}>
      {% elif type == 'publication' %}
        <{{ heading }}><a href="{{ item.file }}">{{ item.title }}</a></{{ heading }}>
        <p>{{ t.year }}: {{ item.year }} · {{ t.type }}: {{ t.publicationTypes[item.type] }}</p>
        <p>{{ t.publicationLanguage }}: {{ item.language }}</p>
        {{ item.body | markdown | safe }}
      {% elif type == 'person' %}
        <{{ heading }}>{{ item.title }}</{{ heading }}>
        <p>{{ item.role }}</p>
        {{ item.body | markdown | safe }}
      {% elif type == 'faq' %}
        <{{ heading }}>{{ item.title }}</{{ heading }}>
        {{ item.body | markdown | safe }}
      {% else %}
        {% if type == 'news' and item.image %}<img data-news-image data-image-layout="card" src="{{ item.image.src }}" alt="{{ item.image.alt[lang] }}">{% endif %}
        {% if type == 'event' %}
          <div class="card-meta">{% if showSectionLabel %}<span class="card-section-label">{{ t.events }}</span>{% endif %}<span class="status status-{{ item.status }}">{{ t[item.status] }}</span></div>
        {% elif type == 'news' and showSectionLabel %}
          <div class="card-meta"><span class="card-section-label">{{ t.news }}</span></div>
        {% endif %}
        <{{ heading }}><a href="/{{ lang }}/{% if type == 'action' %}opportunities{% elif type == 'story' %}stories{% else %}{{ type }}{% if type == 'event' %}s{% endif %}{% endif %}/{{ item.slug }}/">{{ item.title }}</a></{{ heading }}>
        {% if type == 'action' %}<p class="action-key-label">{{ t.keyAction }}: {{ t.keyActions[item.keyAction] }}</p>{% endif %}
        {% if item.date %}
          <p class="card-date"><time datetime="{{ item.date }}">{% if type == 'news' %}{{ item.date | dateLabel(t, 'UTC', false) }}{% else %}{{ item.date | dateLabel(t, item.timeZone) }}{% endif %}</time></p>
        {% endif %}
        <div class="card-body">{% if type == 'action' %}{{ item.summary | markdown | safe }}{% elif type == 'news' %}{{ item.body | newsSummary | safe }}{% else %}{{ item.body | markdown | safe }}{% endif %}</div>
      {% endif %}
    </li>
  {% else %}
    <li class="card empty-state">{{ t.empty }}</li>
  {% endfor %}
</ul>
{% endmacro %}
