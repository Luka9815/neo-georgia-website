{% macro cards(items, type, t, lang, heading='h3', showSectionLabel=false, emptyMessage='', compact=false, photoCredits={}) %}
<ul class="cards cards-{{ type }}{% if compact %} cards-compact{% endif %}"{% if type == 'publication' %} data-publications{% endif %}>
  {% for item in items %}
    <li class="card{% if type == 'action' or type == 'news' or type == 'resource' or type == 'publication' %} card-clickable{% endif %}{% if type == 'news' and not item.image %} news-text-only{% endif %}"{% if type == 'publication' %} data-year="{{ item.year }}" data-type="{{ item.type }}"{% endif %}>
      {% if type == 'call' %}
        <div class="card-meta">{% if showSectionLabel %}<span class="card-section-label">{{ t.calls }}</span>{% endif %}<span class="status status-{{ item.status }}">{{ t[item.status] }}</span></div>
        <{{ heading }}><a href="/{{ lang }}/opportunities/{{ item.action }}/">{{ item.title }}</a></{{ heading }}>
        <p class="card-date"><time datetime="{{ item.deadline }}">{{ item.deadline | dateLabel(t) }}</time><br><span class="card-timezone">{{ t.brussels }}</span></p>
        {{ item.body | markdown | safe }}
        <a class="card-link" href="{{ item.url }}">{{ t.officialLinks }}</a>
      {% elif type == 'resource' %}
        <p class="source-label source-{{ item.source }}">{{ t.source }}: {{ t[item.source] }}</p>
        <{{ heading }}><a class="card-primary" href="{{ item.url }}">{{ item.title }}</a></{{ heading }}>
        {{ item.body | markdown | safe }}
      {% elif type == 'publication' %}
        <{{ heading }}><a class="card-primary" href="{{ item.url or item.file }}">{{ item.title }}</a></{{ heading }}>
        <p>{{ t.year }}: {{ item.year }} · {{ t.type }}: {{ t.publicationTypes[item.type] }}</p>
        <p>{{ t.publicationLanguage }}: {{ item.language }}</p>
        {% if item.publisher %}<p>{{ t.publisher }}: {{ item.publisher }}</p>{% endif %}
        {{ item.body | markdown | safe }}
      {% elif type == 'person' %}
        <{{ heading }}>{{ item.title }}</{{ heading }}>
        {% if item.roleBased %}<p>{{ t.nameLabel }}: {{ item.name }}</p><p>{{ t.roleEmail }}: {% if '@' in item.roleEmail %}<a href="mailto:{{ item.roleEmail }}">{{ item.roleEmail }}</a>{% else %}{{ item.roleEmail }}{% endif %}</p>{% endif %}
        {{ item.body | markdown | safe }}
      {% elif type == 'faq' %}
        <details class="faq-item"><summary><{{ heading }}>{{ item.title }}</{{ heading }}></summary><div class="faq-answer">
        {{ item.body | markdown | safe }}
        {% if item.sourceUrl %}<p class="source-label"><a href="{{ item.sourceUrl }}">{{ t.official }}</a></p>{% endif %}
        </div></details>
      {% else %}
        {% if type == 'action' %}<span class="icon-slot">{{ item.slug | actionIcon | icon | safe }}</span>{% endif %}
        {% if type == 'news' and item.image %}<img data-news-image data-image-layout="card" src="{{ item.image.src }}" alt="{{ item.image.alt[lang] }}">
        {% if photoCredits.dissemination and item.image.src == photoCredits.dissemination.src %}<p class="news-photo-credit" data-news-photo-credit>{{ photoCredits.dissemination.credit[lang] }}</p>{% endif %}{% endif %}
        {% if type == 'event' %}
          <div class="card-meta">{% if showSectionLabel %}<span class="card-section-label">{{ t.events }}</span>{% endif %}<span class="status status-{{ item.status }}">{{ t[item.status] }}</span></div>
        {% elif type == 'news' and showSectionLabel %}
          <div class="card-meta"><span class="card-section-label">{{ t.news }}</span></div>
        {% endif %}
        <{{ heading }}><a{% if type == 'action' or type == 'news' %} class="card-primary"{% endif %} href="/{{ lang }}/{% if type == 'action' %}opportunities{% elif type == 'story' %}stories{% else %}{{ type }}{% if type == 'event' %}s{% endif %}{% endif %}/{{ item.slug }}/">{{ item.title }}</a></{{ heading }}>
        {% if type == 'action' %}<p class="action-key-label">{{ t.keyAction }}: {{ t.keyActions[item.keyAction] }}</p>{% endif %}
        {% if item.date %}
          <p class="card-date"><time datetime="{{ item.date }}">{% if type == 'news' %}{{ item.date | dateLabel(t, 'UTC', false) }}{% else %}{{ item.date | dateLabel(t, item.timeZone) }}{% endif %}</time></p>
        {% endif %}
        {% if not compact %}<div class="card-body">{% if type == 'action' %}{{ item.summary | markdown | safe }}{% elif type == 'news' %}{{ item.body | newsSummary | safe }}{% else %}{{ item.body | markdown | safe }}{% endif %}</div>{% endif %}
      {% endif %}
    </li>
  {% else %}
    <li class="card empty-state">{{ emptyMessage or t.empty }}</li>
  {% endfor %}
</ul>
{% endmacro %}
