{% macro photoCredit(photo,lang,t) %}
<span data-photo-credit="{{ photo.id }}">{% if photo.author %}
{{ t.photoLabel }}: {{ photo.author }}, <a href="{{ photo.licenceUrl }}" rel="license">{{ t.publicDomain if photo.publicDomain else photo.licence }}</a>, {{ t.photoViaCommons }} (<a href="{{ photo.source }}">{{ photo.title }}</a>).
<span class="photo-modified">{% if photo.crop == false %}{{ t.photoResized }}{% else %}{{ t.photoModifiedOverlay if photo.overlay else t.photoModified }}{% endif %}.</span>
{% else %}<a href="{{ photo.source }}">{{ photo.credit[lang] }}</a> · {{ photo.change[lang] }} {{ t.photoSitePermission }}{% endif %}</span>
{% endmacro %}
