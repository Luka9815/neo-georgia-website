<ul class="cards audience-tiles">
{% for audience in findAudiences %}
<li class="card card-clickable"{% if audience.slug == 'student' or audience.slug == 'university' %} data-sector="higher-education"{% else %} data-sector="{{ audience.slug }}"{% endif %}><span class="icon-slot">{{ audience.icon | icon | safe }}</span><{{ audienceHeading or 'h2' }}><a class="card-primary" href="/{{ view.lang }}/find/{{ audience.slug }}/">{{ audience[view.lang] }}</a></{{ audienceHeading or 'h2' }}><span class="card-arrow" aria-hidden="true">{{ 'arrow-up-right' | icon | safe }}</span></li>
{% endfor %}
</ul>
