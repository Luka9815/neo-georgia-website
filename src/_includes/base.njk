<!doctype html>
<html lang="{{ view.lang }}">
<head>
  <meta charset="utf-8">
  {% if view.target %}<meta http-equiv="refresh" content="0;url={{ view.target }}">{% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ t.site }}</title>
  <meta name="description" content="{{ title }}. {{ t.previewNotice }}">
  {% if not site.siteLaunched or view.kind == '404' or view.target %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}
  <link rel="canonical" href="{{ (view.target or view.path) | absoluteUrl(site.url) }}">
  <link rel="alternate" hreflang="{{ view.lang }}" href="{{ view.path | absoluteUrl(site.url) }}">
  {% if view.translated != false %}<link rel="alternate" hreflang="{{ other }}" href="{{ view.alternate | absoluteUrl(site.url) }}">{% endif %}
  <meta property="og:title" content="{{ title }} | {{ t.site }}">
  <meta property="og:description" content="{{ t.previewNotice }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ view.path | absoluteUrl(site.url) }}">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<a class="skip" href="#main">{{ t.skip }}</a>
{% from 'navigation.njk' import navigationMenu %}
<div class="preview-bar"><p class="wrapper notice">{{ t.previewNotice }}</p></div>
<header class="site-header">
  <div class="wrapper header-inner">
    <div class="header-top">
      <a class="brand" href="/{{ view.lang }}/" aria-label="{{ t.officeName }}">
        {% if site.logoPath %}<img class="brand-image" src="{{ site.logoPath }}" alt="{{ t.logoAlt }}" width="240" height="80">{% endif %}
        <span class="brand-name">{{ t.officeName }}</span>
      </a>
      <div class="header-tools">
      <a class="search-link" href="/{{ view.lang }}/search/" aria-label="{{ t.search }}">{{ 'search' | icon | safe }}<span class="search-label">{{ t.search }}</span></a>
      <div class="language-control"><span class="language-current" lang="{{ view.lang }}">{{ 'ქა' if view.lang == 'ka' else 'EN' }}</span><span aria-hidden="true">|</span><a class="language-switch" href="{{ view.alternate }}" lang="{{ other }}" hreflang="{{ other }}" aria-label="{{ 'EN' if other == 'en' else 'ქა' }}: {{ t.switch }}">{{ 'EN' if other == 'en' else 'ქა' }}</a></div>
      </div>
    </div>
    {{ navigationMenu(navigation, t, view, 'desktop-navigation') }}
    <details class="mobile-menu">
      <summary>{{ t.menuToggle }}<span class="menu-chevron" aria-hidden="true"></span></summary>
      {{ navigationMenu(navigation, t, view, 'mobile-navigation') }}
    </details>
  </div>
</header>
<main id="main" class="wrapper page-main page-{{ view.kind }}" tabindex="-1">
  {% if view.kind != 'home' and view.kind != 'action' %}<h1 id="page-title"{% if view.kind == 'news' and view.slug %} class="news-title"{% endif %}>{{ title }}</h1>{% endif %}
  {{ body | safe }}
</main>
<footer class="site-footer">
  <div class="wrapper">
    <div class="footer-grid">
      <section>
        <h2>{{ t.contact }}</h2>
        <p>{{ t.email }}: {{ t.contactEmail }}</p>
        <p><a href="/{{ view.lang }}/about/contact/">{{ t.contact }}</a></p>
        {% if socialLinks.length %}
        <h3>{{ t.social }}</h3>
        <ul>{% for link in socialLinks %}<li><a href="{{ link.url }}">{{ link[view.lang] }}</a></li>{% endfor %}</ul>
        {% endif %}
      </section>
      <nav aria-label="{{ t.quickLinks }}">
        <h2>{{ t.quickLinks }}</h2>
        <ul>{% for key in ['opportunities','calls','resources'] %}<li><a href="/{{ view.lang }}/{{ key }}/">{{ t[key] }}</a></li>{% endfor %}</ul>
      </nav>
      <nav aria-label="{{ t.about }}">
        <h2>{{ t.legal }}</h2>
        <ul>
          {% for key in ['privacy','accessibility','language'] %}
            <li><a href="/{{ view.lang }}/{{ key }}/">{{ t[key] }}</a></li>
          {% endfor %}
          <li><a href="/{{ view.lang }}/about/credits/">{{ t.credits }}</a></li>
        </ul>
      </nav>
    </div>
    <p class="language-policy">{{ t.prevailingStatement }}</p>
    <div class="eu-footer">
      <img data-eu-emblem class="eu-emblem" src="{{ t.emblemPath }}" alt="{{ t.emblemAlt }}" width="{{ t.emblemWidth }}" height="{{ t.emblemHeight }}" loading="lazy">
      <div class="eu-funding">
        <p class="funding-disclaimer">{{ t.disclaimer }}</p>
        {% if view.kind == '404' %}<p lang="en">{{ en.disclaimer }}</p>{% endif %}
      </div>
    </div>
  </div>
</footer>
</body>
</html>
