<!doctype html>
<html lang="{{ view.lang }}">
<head>
  <meta charset="utf-8">
  {% if view.target %}<meta http-equiv="refresh" content="0;url={{ view.target }}">{% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ t.site }}</title>
  <meta name="description" content="{{ title }}. {{ t.sample }}">
  {% if not site.siteLaunched or view.kind == '404' or view.target %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}
  <link rel="canonical" href="{{ (view.target or view.path) | absoluteUrl(site.url) }}">
  <link rel="alternate" hreflang="{{ view.lang }}" href="{{ view.path | absoluteUrl(site.url) }}">
  {% if view.translated != false %}<link rel="alternate" hreflang="{{ other }}" href="{{ view.alternate | absoluteUrl(site.url) }}">{% endif %}
  <meta property="og:title" content="{{ title }} | {{ t.site }}">
  <meta property="og:description" content="{{ t.sample }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ view.path | absoluteUrl(site.url) }}">
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<a class="skip" href="#main">{{ t.skip }}</a>
{% from 'navigation.njk' import navigationMenu %}
<header class="site-header">
  <div class="wrapper header-inner">
    <div class="header-top">
      <a class="brand" href="/{{ view.lang }}/">
        <span class="brand-name">{{ t.logoName }}</span>
        <span class="brand-description">{{ t.officeName }}</span>
        <span class="brand-note">{{ t.logoPlaceholder }}</span>
      </a>
      <a class="language-switch" href="{{ view.alternate }}" lang="{{ other }}" hreflang="{{ other }}">{{ t.switch }}</a>
    </div>
    {{ navigationMenu(navigation, t, view, 'desktop-navigation') }}
    <details class="mobile-menu">
      <summary>{{ t.menuToggle }}<span class="menu-chevron" aria-hidden="true"></span></summary>
      {{ navigationMenu(navigation, t, view, 'mobile-navigation') }}
    </details>
  </div>
</header>
<main id="main" class="wrapper page-main" tabindex="-1">
  <p class="notice">{{ t.sample }}</p>
  {% if view.kind != 'home' %}<h1>{{ title }}</h1>{% endif %}
  {{ body | safe }}
</main>
<footer class="site-footer">
  <div class="wrapper">
    <div class="footer-grid">
      <section>
        <h2>{{ t.contact }}</h2>
        <p>{{ t.contactPlaceholder }}</p>
        <h3>{{ t.social }}</h3>
        <p>{{ t.socialPlaceholder }}</p>
      </section>
      <nav aria-label="{{ t.about }}">
        <ul>
          {% for key in ['privacy','accessibility','language'] %}
            <li><a href="/{{ view.lang }}/{{ key }}/">{{ t[key] }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
    <div class="eu-footer">
      <div class="emblem-placeholder">{{ t.emblem }}</div>
      <div class="eu-funding">
        <p><strong>{{ t.funding }}</strong></p>
        <p{% if view.lang == 'ka' %} lang="en"{% endif %}>{{ t.disclaimer }}</p>
        {% if view.kind == '404' %}<p lang="en">{{ en.disclaimer }}</p>{% endif %}
      </div>
    </div>
  </div>
</footer>
</body>
</html>
